# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
PORT=1200
NODE_ENV=development
APP_NAME="WhatsApp Web"
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173"
# Use "none" when the deployed frontend and API use different domains.
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"

# ==============================================================================
# DATABASE
# ==============================================================================
DB_CONNECT_STRING="mongodb+srv://<username>:<password>@cluster0.mongodb.net/chat_app?retryWrites=true&w=majority"

# ==============================================================================
# JWT & SECURITY TOKENS
# ==============================================================================
# Generate strong 64-char strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long"
OTP_PEPPER="your_otp_pepper_salt_string_for_sha256_hash"

# ==============================================================================
# EMAIL (NODEMAILER / SMTP)
# ==============================================================================
# For Gmail App Password: Host: smtp.gmail.com, Port: 587, User: your email, Pass: 16-char App Password
# For Production: Brevo, AWS SES, Resend, or Mailgun
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="your-email@gmail.com"

# ==============================================================================
# SMS (TWILIO)
# ==============================================================================
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# Option A (Recommended): Twilio Verify Service SID (starts with VA...)
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Option B: Twilio Programmable SMS Phone Number (starts with +)
TWILIO_PHONE_NUMBER="+1234567890"

# ==============================================================================
# MEDIA STORAGE (CLOUDINARY)
# ==============================================================================
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
